{
  "name": "studiowav",
  "version": "0.8.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lumarri/StudioWav.git"
  },
  "homepage": "https://github.com/Lumarri/StudioWav#readme",
  "bugs": {
    "url": "https://github.com/Lumarri/StudioWav/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "description": "EstaciÃ³n de producciÃ³n musical por patrones para Windows",
  "author": "StudioWav",
  "main": "electron/main.cjs",
  "allowScripts": {
    "electron": true,
    "esbuild": true
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop": "node scripts/desktop.mjs",
    "start": "electron .",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/project.test.ts tests/native-lifecycle.test.cjs tests/music-tools.test.ts tests/plugins.test.ts tests/plugin-library.test.cjs tests/midi.test.ts tests/channel-effects.test.ts tests/instrument-bank.test.cjs",
    "test:e2e": "playwright test",
    "native:setup": "python scripts/setup-native-tools.py",
    "native:build": "node scripts/build-native.mjs",
    "test:native": "node scripts/test-native.mjs",
    "dist": "npm run native:build && npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "lucide-react": "1.69.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "^26.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  },
  "build": {
    "appId": "dev.studiowav.app",
    "productName": "StudioWav",
    "directories": {
      "output": "release/0.8.0"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "examples",
        "to": "examples"
      },
      {
        "from": "native/bin/plugins",
        "to": "audio/plugins"
      },
      {
        "from": "native/bin/StudioWavAudio.exe",
        "to": "audio/StudioWavAudio.exe"
      },
      {
        "from": "native/bin/licenses",
        "to": "licenses"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "StudioWav-${version}-portable.exe"
    }
  }
}
